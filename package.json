{
  "name": "batonpass",
  "productName": "BatonPass",
  "version": "0.2.1",
  "description": "Desktop widget that shows how full each Claude Code chat's context window is, and hands a chat off to a fresh session in a new terminal before it runs out of room.",
  "private": true,
  "main": "main.js",
  "author": "krlosdev",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "generate-icons": "node scripts/generate-icons.js",
    "icons": "node scripts/derive-icons.js",
    "site:assets": "node scripts/site-assets.js",
    "postinstall": "node scripts/generate-icons.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "dev.krlosdev.batonpass",
    "productName": "BatonPass",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KrlosDev",
        "repo": "BatonPass",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "koffi": "^3.2.0"
  }
}
